# ---------------- Security ----------------
SECRET_KEY=replace-with-a-long-random-secret

# ---------------- Google Sign-In ----------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/callback

# ---------------- Groq ----------------
# One Groq key is enough. Compound automatically performs live web search when needed.
GROQ_API_KEY=gsk_your_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-20b
# RAGORA intentionally ignores stale 120B/retired model values from older .env files.
WEB_MODEL=groq/compound-mini

# Optional tuning
LLM_TIMEOUT=45
MAX_OUTPUT_TOKENS=220
MAX_HISTORY_MESSAGES=4
RETRIEVAL_MIN_SCORE=0.12

# For reliable low-token chat, the default is openai/gpt-oss-20b.
# RAGORA automatically uses WEB_MODEL only when the document does not contain the answer.
# Compound Mini performs Groq built-in real-time web search; no separate search API key is required.

# Production
PRODUCTION=1
COOKIE_SECURE=1
# For Render persistent disk:
# DB_PATH=/var/data/ragora.db
# UPLOAD_DIR=/var/data/uploads
