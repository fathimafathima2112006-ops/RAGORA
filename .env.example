# ---------------- Security ----------------
SECRET_KEY=replace-with-a-long-random-secret

# ---------------- Google Sign-In ----------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/callback

# ---------------- Groq ----------------
# One Groq key powers the answer engine. Web-aware fallback uses public search context.
GROQ_API_KEY=gsk_your_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-20b
# RAGORA intentionally ignores stale 120B/retired model values from older .env files.
WEB_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional tuning
LLM_TIMEOUT=45
MAX_OUTPUT_TOKENS=520
MAX_HISTORY_MESSAGES=6
RETRIEVAL_MIN_SCORE=0.12

# RAGORA keeps prompts compact for fast, stable responses and switches to a longer
# generation when the user explicitly asks for a detailed explanation.

# Production
PRODUCTION=1
COOKIE_SECURE=1
# For Render persistent disk:
# DB_PATH=/var/data/ragora.db
# UPLOAD_DIR=/var/data/uploads

# Maximum size for each uploaded file (MB)
MAX_FILE_SIZE_MB=500
